{
  "name": "ykuatianangareko",
  "version": "1.0.0",
  "description": "API de facturación para junta de saneamiento Ykuatia",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/server.js",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/db.config.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/db.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/db.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/db.config.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/db.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "db:setup": "npm run migration:run",
    "hash-passwords": "ts-node --transpile-only src/scripts/hashExistingPasswords.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/"
  },
  "homepage": "https://github.com/",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "node-cron": "^4.2.1",
    "pdfmake": "^0.2.23",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.15",
    "@types/node-cron": "^3.0.11",
    "@types/pdfmake": "^0.2.13",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
